/* pages/stroke/stroke.wxss */
.container {
  padding: 40rpx;
}

.header {
  text-align: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
}

.card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  text-align: center;
}

.hanzi-display {
  font-size: 120rpx;
  color: #4CAF50;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.stroke-info {
  font-size: 28rpx;
  color: #666;
}

.canvas-container {
  background: white;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.hanzi-canvas {
  width: 100%;
  height: 600rpx;
  border: 2rpx dashed #E0E0E0;
  border-radius: 12rpx;
}

.actions {
  display: flex;
  gap: 15rpx;
  margin-bottom: 20rpx;
}

.btn-primary {
  flex: 1;
  background-color: #FF5722;
  color: white;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  border: none;
}

.btn-secondary {
  flex: 1;
  background-color: #2196F3;
  color: white;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  border: none;
}

.btn-success {
  flex: 1;
  background-color: #4CAF50;
  color: white;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  border: none;
}

.tips {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  border-radius: 16rpx;
  padding: 25rpx;
  text-align: center;
}

.tips-text {
  color: white;
  font-size: 28rpx;
}
