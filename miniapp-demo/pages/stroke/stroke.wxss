/* pages/stroke/stroke.wxss */
.container {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
}

.card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  text-align: center;
}

.hanzi-display {
  font-size: 120rpx;
  color: #4CAF50;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.stroke-info {
  font-size: 28rpx;
  color: #666;
}

/* 画布外层包裹容器 - 居中显示 */
.canvas-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  margin: 40rpx 0;
}

/* 画布容器 - 放大尺寸 */
.canvas-container {
  position: relative;
  width: 600rpx;
  height: 600rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.12);
  overflow: hidden;
}

/* 米字格背景 */
.grid-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

/* 米字格线条通用样式 */
.grid-line {
  position: absolute;
  background-color: #E8F5E9;
}

/* 横线 */
.grid-horizontal {
  top: 50%;
  left: 0;
  width: 100%;
  height: 2rpx;
  transform: translateY(-50%);
}

/* 竖线 */
.grid-vertical {
  left: 50%;
  top: 0;
  width: 2rpx;
  height: 100%;
  transform: translateX(-50%);
}

/* 对角线1（左上到右下）*/
.grid-diagonal-1 {
  top: 0;
  left: 0;
  width: 141.42%; /* sqrt(2) * 100% */
  height: 2rpx;
  transform-origin: top left;
  transform: rotate(45deg);
}

/* 对角线2（右上到左下）*/
.grid-diagonal-2 {
  top: 0;
  right: 0;
  width: 141.42%; /* sqrt(2) * 100% */
  height: 2rpx;
  transform-origin: top right;
  transform: rotate(-45deg);
}

/* 画布本身 */
.hanzi-canvas {
  position: relative;
  width: 100%;
  height: 100%;
  z-index: 2;
}

.actions {
  display: flex;
  gap: 15rpx;
  margin-bottom: 20rpx;
  width: 100%;
  max-width: 600rpx;
}

.btn-primary {
  flex: 1;
  background-color: #FF5722;
  color: white;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  border: none;
}

.btn-secondary {
  flex: 1;
  background-color: #2196F3;
  color: white;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  border: none;
}

.btn-success {
  flex: 1;
  background-color: #4CAF50;
  color: white;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  border: none;
}

.tips {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  border-radius: 16rpx;
  padding: 25rpx;
  text-align: center;
}

.tips-text {
  color: white;
  font-size: 28rpx;
}
