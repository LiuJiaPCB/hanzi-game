<!--pages/stroke/stroke.wxml-->
<view class="container">
  <view class="header">
    <text class="title">✍️ 笔画练习</text>
  </view>

  <view class="card">
    <view class="hanzi-display">{{currentHanzi}}</view>
    <view class="stroke-info">
      <text>笔画顺序：{{strokeOrder}}</text>
    </view>
  </view>

  <view class="canvas-container">
    <canvas 
      canvas-id="hanziCanvas" 
      class="hanzi-canvas"
      bindtouchstart="touchStart"
      bindtouchmove="touchMove"
      bindtouchend="touchEnd"
    ></canvas>
  </view>

  <view class="actions">
    <button class="btn-primary" bindtap="clearCanvas">清空画布</button>
    <button class="btn-secondary" bindtap="showStroke">显示笔画</button>
    <button class="btn-success" bindtap="nextHanzi">下一个</button>
  </view>

  <view class="tips">
    <text class="tips-text">💡 在画布上临摹汉字笔画</text>
  </view>
</view>
